# Copie para .env e troque os valores antes de subir no NAS.

# Senha do Postgres (só usada dentro da rede do compose).
POSTGRES_PASSWORD=troque-esta-senha

# Segredo da sessão, com pelo menos 32 caracteres. Gere com: openssl rand -hex 32
SESSION_SECRET=

# true quando o acesso for por HTTPS (Cloudflare Tunnel ou proxy com TLS).
# false para acessar pela rede local em http://IP-DO-NAS:3003.
COOKIE_SECURE=false

# Digital e Face ID só funcionam em https com nome (Tailscale ou Cloudflare Tunnel).
# Deixe vazio enquanto o acesso for só pelo IP. Com o túnel, use o host da página:
# WEBAUTHN_RP_ID=familia.exemplo.com
# WEBAUTHN_ORIGIN=https://familia.exemplo.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# true até as duas pessoas existirem na casa. Depois disso, mude para false e suba de novo.
ALLOW_REGISTER=true

# Porta publicada no NAS.
WEB_PORT=3003

# Pasta dos backups diários, de preferência fora do volume do banco (outro disco ou pasta sincronizada).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=3
