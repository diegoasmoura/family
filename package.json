{
  "name": "app-financas",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,yellow \"npm run dev -w @fin/api\" \"npm run dev -w @fin/web\"",
    "build": "npm run build -w @fin/web",
    "migrate": "npm run migrate -w @fin/api",
    "seed": "npm run seed -w @fin/api",
    "test": "vitest run",
    "typecheck": "tsc -p packages/domain && tsc -p packages/db && tsc -p apps/api && tsc -p apps/web",
    "lint": "eslint . && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
